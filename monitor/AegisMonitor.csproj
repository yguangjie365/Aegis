<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Aegis 传感器 sidecar（🔴 唯一传感器出口，ADR-001 §2.4）
    移植来源：Source/NexBox/monitor/NexBoxMonitor.csproj（GPL-3.0 同源，登记见 ../../DEPENDENCIES.md §三/§四）
    包版本一律钉 NexBox 实测值（project.assets.json），不追新。
    与 NexBox 的差异：🔴 不含任何第三方内核驱动的分发/安装逻辑（PawnIO 零分发，见 DEPENDENCIES.md §四）。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>AegisMonitor</AssemblyName>
    <RootNamespace>AegisMonitor</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.Text.Json" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Management" />
  </ItemGroup>
</Project>
